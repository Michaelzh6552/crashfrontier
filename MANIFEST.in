include LICENSE
include README.md
include pyproject.toml
recursive-include crashfrontier *.py
recursive-include tests *
global-exclude *.py[cod]
global-exclude *.so
global-exclude .DS_Store
prune .venv
prune build
prune dist
prune .pytest_cache
prune site
prune site_en
prune outputs
prune DATA
prune crashfrontier.egg-info
recursive-exclude * __pycache__
recursive-exclude * *.egg-info
